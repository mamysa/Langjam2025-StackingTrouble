global CELL_SIZE = 64
global BOARD_CELLS_ALONG_X = 12
global BOARD_CELLS_ALONG_Y = 6


global HORIZONTAL_MOVEMENT_LEFT = -1
global HORIZONTAL_MOVEMENT_RIGHT = 1


global VERTICAL_MOVEMENT_FALLING = -1
global VERTICAL_MOVEMENT_JUMPING = 1

# steal these from raylib enum
global RL_KEY_SPACE = 32
global RL_KEY_RIGHT = 262
global RL_KEY_LEFT = 263
global RL_KEY_ENTER = 257


global MOVEMENT_EPS = 0.01
global VELOCITY = 1.75

global CRATE_HEIGHT = 1
global PLAYER_HEIGHT = 2

global PUSHING_DISTANCE = 0.05

global PICK_UP_CRATE_DESPAWN_AFTER = 16
global EXPLODER_CRATE_EXPLODE_AFTER = 5 

global EXPLODER_CRATE_EXPLOSION_RADIUS = 2

global SCORE_PER_CRATE_DESTROYED = 1

# if player tries to move during this cooldown, input is not applied.
global PLAYER_MOVEMENT_COOLDOWN = 0.02

# for how long player will stay incapacitated?
global PLAYER_INCAPACITATION_COOLDOWN = 2

global PLAYER_LIVENESS_DEAD = 1 # player is dead-dead, no lives remaining.
global PLAYER_LIVENESS_INCAPACITATED = 2 # player dead but has lives remaining.

# if player tries to jump during this cooldown, input is not applied.
global PLAYER_JUMP_COOLDOWN = 0.56

global INITIAL_CRATE_SPAWN_TIMER = 5.5
global INITIAL_CRATE_RANDOM_SPAWN_CHANCE = 0.0008

global DOUBLE_SPEED_DURATION = 4
global DOUBLE_SPEED_VELOCITY_MULTIPLIER = 1.5

global SCREEN_WIDTH = 800
global SCREEN_HEIGHT = 600

global BOARD_CRATE_EXIT_MARGIN = 2

global BOARD_CAMERA = make_2d_camera()


global ASSET_REGISTRY = {}

# defines what happens when a player and crate interact along the y axis (due to gravity and what not).
# Normal behaviour would be to crush the player, but for pickups (such as health) crate should be despawned.
global CRATE_GRAVITY_BEHAVIOR_CRUSH = 1
global CRATE_GRAVITY_BEHAVIOR_PICKUP = 2


def make_2d_camera() {
	scale = 0.7;
	# want to achieve equal spacing horizontally. Compute board dimensions along X, subtract from screen width and divide by half.
	# That will be our horizontal offset.
	board_size_along_x = global(CELL_SIZE) * global(BOARD_CELLS_ALONG_X) * scale;
	offset_x = max((global(SCREEN_WIDTH) - board_size_along_x) * 0.5, 0.0);
	offset_y = global(CELL_SIZE) * scale * 2;

	offset_vector_2d = {};
	offset_vector_2d.x = offset_x;
	offset_vector_2d.y = offset_y;

	target_vector_2d = {};
	target_vector_2d.x = 0;
	target_vector_2d.y = 0;

	camera = {};
	camera.offset = offset_vector_2d;
	camera.target = target_vector_2d;
	camera.rotation = 0.0;
	camera.scale = scale;

	return camera;
}

def board_x_coordinate_in_bounds(x) {
	return x >= 0 and x < global(BOARD_CELLS_ALONG_X);
}

def board_x_coordinate_in_bounds_with_margin(x) {
	margin = global(BOARD_CRATE_EXIT_MARGIN);
	return x >= -margin and x < global(BOARD_CELLS_ALONG_X) + margin;
}

def abs(a) {
	return a if a >= 0 else -a;
}

def min(a, b) {
	return a if a < b else b;
}

def max(a, b) {
	return a if a > b else b;
}

def lerp_find_t(a, b, x) {
	return (x-a) / (b-a);
}

# returns new list with entry at index removed
def list_remove_at_index(a, index) {
	assert (index >= 0 and index < len(a));

	new_list = [];
	i = 0; 
	while i < index {
		new_list = new_list + a[i];
		i = i + 1;
	}
	j = index + 1; 
	while j < len(a) {
		new_list = new_list + a[j];
		j = j + 1;
	}
	return new_list;
}

def list_insert_after_index(a, index, elem) {
	assert ((index >= 0 and index < len(a)) or index == -1);

	if index == -1 {
		# prepend to list
		new_list = [] + elem;
		i = 0;
		while i < len(a) {
			new_list = new_list + a[i];
			i = i + 1;
		}
		return new_list;
	}

	new_list = [];
	i = 0;
	while i < index + 1 {
		new_list = new_list + a[i];
		i = i + 1;
	}
	# add element
	new_list = new_list + elem;
	j = index + 1;
	while j < len(a) {
		new_list = new_list + a[j];
		j = j + 1;
	}
	return new_list;
}

# Timer. To be used for to prevent user from applying too many move/jump commands. 
def timer_new(default_duration) {
 	timer = {};
	timer.default_duration = default_duration;
	timer.is_applied = False;
	timer.counter = 0.0;
	return timer;
}

# initialized the timer to its default duration.
def timer_arm(self) {
	self.counter = self.default_duration;
	self.is_applied = True;
}

# ticks the timer :)
def timer_tick(self, dt) {
	if not self.is_applied  {
		return;
	}

	self.counter = self.counter - dt;

	if self.counter < 0 {
		self.is_applied = False;
		self.counter = 0.0;
	}
}

# Interval represents line segment.
def interval_new(a, b) {
	interval = {};
	interval.min = min(a, b);
	interval.max = max(a, b);
	return interval;
}

# This checks if either interval b completely on the right of a or b os on the left of a and returns negation of that.
def intervals_overlap(a, b) {
	return not ((b.min > a.min and b.min > a.max) or (a.min > b.max and a.max > b.max));
}

def interval_contains_point(interval, a) {
	return interval.min <= a and a <= interval.max;
}

def crate_get_offboard_destination(hmv) {
	if hmv ==  global(HORIZONTAL_MOVEMENT_LEFT) {
		return (-global(BOARD_CRATE_EXIT_MARGIN) - 1);
	}

	if hmv ==  global(HORIZONTAL_MOVEMENT_RIGHT) {
		return (global(BOARD_CELLS_ALONG_X) + global(BOARD_CRATE_EXIT_MARGIN) + 1);
	}

	assert(False);
}

# Player object. 
# (1) Stores (x,y) coodinates of the player. Can be float
# (2) Stores previousGoalX and currentGoalX int coordinates of target cells on the board.
#     Initially currentGoalX is None and previousGoalX is set to x. (x assumed to be an integer.)
# 	  When player moves, current_goal_x is set and movement is performed.
#     When player reaches his current_goal_x, last_goal_x = current_goal_x and set current_goal_x to None
# (3) To track in which direction player is moving, maintain horizontal_movement_kind. This will allow to
#     alter player's movement direction in certain cases. When player reaches his goal, this field is set to None.
# (4) goal_y for storing y coordinate player must reach while jumping. 
def player_new(x, y) {
	player = {};
	player.x = x;
	player.y = y;

	player.previous_goal_x = x;
	player.current_goal_x = None;

	player.horizontal_movement_kind = None;


	player.goal_y = None;
	player.vertical_movement_kind = None;

	player.move = &player_move;
	player.jump = &player_jump;
	player.tick = &player_tick;
	player.draw = &player_draw;
	player.get_y_axis_span = &player_get_y_span;

	player.movement_cooldown_timer = timer_new(global(PLAYER_MOVEMENT_COOLDOWN));
	player.jump_cooldown_timer = timer_new(global(PLAYER_JUMP_COOLDOWN));
	player.incapacitation_cooldown_timer = timer_new(global(PLAYER_INCAPACITATION_COOLDOWN));
	player.respawn_invulnerability_cooldown_timer = timer_new(global(PLAYER_INCAPACITATION_COOLDOWN) + 2);
	player.is_pushing = False;
	player.liveness = None; # none if player is alive and okay.
	player.health = 3; # number of lives the player has

	return player;
}


def _player_lose_life(self) {
	self.health = max(0, self.health - 1);
	self.liveness = global(PLAYER_LIVENESS_DEAD);
	
	if self.health > 0 {
		self.liveness = global(PLAYER_LIVENESS_INCAPACITATED);
		timer_arm(self.incapacitation_cooldown_timer);
		timer_arm(self.respawn_invulnerability_cooldown_timer);
	}
}

# checks if player is crushed by a crate. Destroy crate if player is jumping.
def player_check_death_condition(self, world) {
	crates_above = [];

	crates_above = crates_above + world_get_lowest_in_column_after(world, self.y + global(PLAYER_HEIGHT), self.previous_goal_x); 

	if self.horizontal_movement_kind != None {
		crates_above = crates_above + world_get_lowest_in_column_after(world, self.y + global(PLAYER_HEIGHT), self.current_goal_x); 
	}

	c = 0;
	while c < len(crates_above) {
		crate_info = crates_above[c];
		crate = crate_info.crate;

		crate_gravity_behavior = global(CRATE_GRAVITY_BEHAVIOR_CRUSH);

		if crate != None {
			crate_gravity_behavior = crate.get_player_gravity_behavior();
		}

		if self.y + global(PLAYER_HEIGHT) >= crate_info.crate_y {
			if crate_gravity_behavior == global(CRATE_GRAVITY_BEHAVIOR_CRUSH) {
				if self.vertical_movement_kind != global(VERTICAL_MOVEMENT_JUMPING) 
				and not self.respawn_invulnerability_cooldown_timer.is_applied {
					_player_lose_life(self);
				} else {
					if self.liveness == None {
						world.score = world.score + global(SCORE_PER_CRATE_DESTROYED);
					}
				}
				crate.explode(crate);
			} else {
			# TODO if player is dead/respawning, this should have no effect.
				if crate != None {
					crate.pick_up_behavior_func(world);
					crate.on_picked_up(crate);
				}
			}
		}
		c = c + 1;
	}
}

def player_can_push_crate(self, crate) {
	player_center_y = self.y + 1;
	crate_top_y = crate.y + 1;
	d = global(PUSHING_DISTANCE);

	p = interval_new(player_center_y - d, player_center_y + d);
	c = interval_new(crate_top_y - d * 2, crate_top_y);

	return intervals_overlap(p, c);
}

def player_move(self, desired_horizontal_movement_kind, world) {
	if self.liveness != None {
			return False;
	}

	if self.movement_cooldown_timer.is_applied {
		return False;
	}

	if self.is_pushing {
		return False;
	}

	if desired_horizontal_movement_kind == None {
		return False;
	}

	if desired_horizontal_movement_kind == self.horizontal_movement_kind {
		# do not allow player to queue multiple movements in the same direction
		return False;
	}

	# compute "bounding box" of the player along y axis
	player_interval = player_get_y_span_scaled(self);

	# player is not moving
	if self.horizontal_movement_kind == None {
		new_target_x = self.previous_goal_x + desired_horizontal_movement_kind;

		if not board_x_coordinate_in_bounds(new_target_x) {
			return False;
		}
		
		overlapping_crates_in_target_column = world.interval_overlaps_any_in_column(world, player_interval, new_target_x);
		if len(overlapping_crates_in_target_column) > 0 {

			#print(len(overlapping_crates_in_target_column));
			#print(overlapping_crates_in_target_column);
			#print(1337);



			if len(overlapping_crates_in_target_column) != 1 {
				return False;
			}

			overlap_info = overlapping_crates_in_target_column[0];
			crate = overlap_info.crate;

			if not player_can_push_crate(self, overlap_info.crate) {
				return False;
			}


			if not crate.move(crate, desired_horizontal_movement_kind, world, overlap_info.index) {
				return False;
			}

			# crate is ok to move, mark player as pushing the crate.
			self.is_pushing = True;
		}



		self.current_goal_x = new_target_x;
		self.horizontal_movement_kind = desired_horizontal_movement_kind;

		return True;
	}

	# otherwise player is moving in the opposite direction, swap previous_goal_X and current_goal_x 
	# and update horizontal_movement_kind
	target_goal_x = self.previous_goal_x;

	# TODO do we even need this? Player's last goal was on the board anyways, right?
	if not board_x_coordinate_in_bounds(target_goal_x) {
		return False;
	}

	# we might not need this either since we are just leaving this cell...
	overlapping_crates_in_target_column = world.interval_overlaps_any_in_column(world, player_interval, target_goal_x);
	if len(overlapping_crates_in_target_column) > 0 {
		return False;
	}

	self.previous_goal_x = self.current_goal_x;
	self.current_goal_x = target_goal_x;
	self.horizontal_movement_kind = desired_horizontal_movement_kind;

	return True;
}

def player_jump(self) {
	if self.liveness != None {
			return False;
	}

	if self.jump_cooldown_timer.is_applied {
		return False;
	}

	if self.is_pushing {
		return False;
	}

  # do not allow double jumping.
	if self.vertical_movement_kind != None {
		return False;
	}

	self.goal_y = self.y + 1 + global(MOVEMENT_EPS) * 2; 
	self.vertical_movement_kind = global(VERTICAL_MOVEMENT_JUMPING);
	return True;
}

def player_tick(self, dt, world) {
	timer_tick(self.movement_cooldown_timer, dt);
	timer_tick(self.jump_cooldown_timer, dt);
	timer_tick(self.incapacitation_cooldown_timer, dt);
	timer_tick(self.respawn_invulnerability_cooldown_timer, dt);

	if self.liveness != global(PLAYER_LIVENESS_DEAD) {
		if not self.incapacitation_cooldown_timer.is_applied {
			self.liveness = None;
		}
	}

	player_tick_horizontal_movement(self, dt, world);
	player_tick_vertical_movement(self, dt, world);
}

# self = player
def player_tick_horizontal_movement(self, dt, world) {
	if self.horizontal_movement_kind == None {
		return;
	}

	horizontal_movement_float = float(self.horizontal_movement_kind);

	velocity = global(VELOCITY) * global(DOUBLE_SPEED_VELOCITY_MULTIPLIER) if world.double_speed_timer.is_applied else global(VELOCITY);

	self.x = self.x + horizontal_movement_float * velocity * dt;

	distance_from_goal = (float(self.current_goal_x) - self.x) * horizontal_movement_float;

	# we have reached the goal
	if global(MOVEMENT_EPS) >= distance_from_goal {
		self.x = float(self.current_goal_x);
		self.previous_goal_x = self.current_goal_x;
		self.current_goal_x = None;
		self.horizontal_movement_kind = None;

		timer_arm(self.movement_cooldown_timer);
		self.is_pushing = False;
	}
}

# If jumping apply contant velocity's to player's y component until destination is reached.
# Once destination has been reached, player goes into FALLING state in which case we simulate gravity until player
# reaches the ground.
def player_tick_vertical_movement(self, dt, world) {

	if self.liveness != None {
		return;
	}

	if self.vertical_movement_kind == global(VERTICAL_MOVEMENT_JUMPING){
		# we are jumping
		self.y = self.y + dt * global(VELOCITY);

		# find the difference between player's goalY and actual position Y and if it is close enough,
		# set player's vertical_movement_kind to falling.

		if self.goal_y - self.y < global(MOVEMENT_EPS) {
			self.y = self.goal_y;
			self.goal_y = None;
			self.vertical_movement_kind = global(VERTICAL_MOVEMENT_FALLING);
			timer_arm(self.jump_cooldown_timer);
		}

	} else {
		# otherwise apply gravity here.
		# assume player is falling and apply gravity.
		self.vertical_movement_kind = global(VERTICAL_MOVEMENT_FALLING);


		ground_info = world.get_highest_in_column_below(world, self.y, self.previous_goal_x); 
		if self.horizontal_movement_kind != None {
			# player is moving, we sample current_goal_x as well and return maximum of those 
			ground_info_2 = world.get_highest_in_column_below(world, self.y, self.current_goal_x); 
			if ground_info_2.crate_y > ground_info.crate_y {
				ground_info = ground_info_2;
			}
		}

		# apply gravity after sampling ground level. Otherwise, we will have a situation when object sinks into a valid crate.
		ground = ground_info.crate_y;
		self.y = self.y - global(VELOCITY) * dt;

		# have we reached ground yet?
		if self.y - ground < global(MOVEMENT_EPS){
			self.y = ground; 
			self.vertical_movement_kind = None;  


			if ground_info.crate != None and ground_info.crate.get_player_gravity_behavior() == global(CRATE_GRAVITY_BEHAVIOR_PICKUP) {
				ground_info.crate.pick_up_behavior_func(world);
				ground_info.crate.on_picked_up(ground_info.crate);
			}
		}
	}
}

def player_draw(self) {
	board_height = global(CELL_SIZE) * global(BOARD_CELLS_ALONG_Y);

	cell_start_x = global(CELL_SIZE) *  self.x;

	#subtract additional CELL_SIZE so that we account for player's height which is twice as large as other objects on scene.
	cell_start_y = board_height - (global(CELL_SIZE) * self.y) - global(CELL_SIZE);

	width = global(CELL_SIZE);
	height = global(CELL_SIZE) * 2; # player occupying two cells vertically.

	if self.respawn_invulnerability_cooldown_timer.is_applied {
		RlDrawRectangle(cell_start_x, cell_start_y, width, height, 0, 0, 255);
		return;
	}

	if self.liveness != None{
		RlDrawRectangle(cell_start_x, cell_start_y, width, height, 0, 0, 0);
	} else {
		RlDrawRectangle(cell_start_x, cell_start_y, width, height, 0, 255, 0);
	}

}

# This should be unused, right?
def player_get_y_span(self) {
	y_start = self.y;
	y_end = self.y + global(PLAYER_HEIGHT);
	return interval_new(y_start, y_end);
}

# so it turns out I actually need to sliighly scale down the interval to make movement work 
# on top of crates
def player_get_y_span_scaled(self) {
	y_start = self.y;
	y_end = self.y + global(PLAYER_HEIGHT);
	return interval_new(y_start+0.08, y_end-0.08);
}


# CRATE OBJECT
def crate_new(x, y) {
	crate = {};
	crate.x = x;
	crate.y = y;
	crate.previous_goal_x = x; 
	crate.current_goal_x = None;
	crate.horizontal_movement_kind = None;
	crate.has_exploded = False;

	crate.set_position = &crate_set_position;
	crate.draw = &crate_draw;
	crate.move = &crate_move;
	crate.get_player_gravity_behavior = &crate_get_player_gravity_behavior;
	crate.get_y_axis_span = &crate_get_y_axis_span;
	crate.get_center = &crate_get_center;
	crate.explode = &crate_explode;
	crate.on_added_to_board = &crate_on_added_to_board;
	crate.should_despawn = &crate_should_despawn;
	crate.color = {};
	crate.color.r = random_int(255);
	crate.color.g = random_int(100);
	crate.color.b = random_int(255);
	crate.tick = &crate_tick;
	return crate;
}

def crate_should_despawn(self) {
	return self.has_exploded;
}

def crate_on_added_to_board(self) {
	# no op for regular crates.
}

def crate_set_position(self, x, y) {
	self.x = x;
	self.y = y;
}

def crate_get_player_gravity_behavior() {
	return global(CRATE_GRAVITY_BEHAVIOR_CRUSH);
}

def crate_draw(self) {
	asset_registry = global(ASSET_REGISTRY);

	board_height = global(CELL_SIZE) * global(BOARD_CELLS_ALONG_Y);

	cellStartX = global(CELL_SIZE) *  self.x;
	cellStartY = board_height - (global(CELL_SIZE) * self.y);

	#RlDrawRectangle(cellStartX, cellStartY, global(CELL_SIZE), global(CELL_SIZE), self.color.r, self.color.g, self.color.b);
	RlDrawTexture(asset_registry.crate, cellStartX, cellStartY);
}

# again, row_index is passed here because object comparisons by reference is borked atm.
def crate_move(self, desired_horizontal_movement_kind, world, row_index) {
	if desired_horizontal_movement_kind == None {
		return False;
	}

	# crate is already moving.
	if self.horizontal_movement_kind != None {
		return False;
	}

	# some crate is being pushed already,.
	if world.pushed_crate != None {
		return False;
	}


	target_goal_x = self.previous_goal_x + desired_horizontal_movement_kind;

	if not board_x_coordinate_in_bounds(target_goal_x) {
		return False;
	}

	e = crate_get_y_span_scaled(self);

	overlapping_crates_in_target_column = world.interval_overlaps_any_in_column(world, e, target_goal_x);
	if len(overlapping_crates_in_target_column) > 0 {
		return False;
	}

	self.horizontal_movement_kind = desired_horizontal_movement_kind;
	self.current_goal_x = target_goal_x;
	world.columns[self.previous_goal_x] = list_remove_at_index(world.columns[self.previous_goal_x], row_index);
	world.pushed_crate = self;

	return True;
}

def crate_explode(self) {
	if self.has_exploded {
		# do not retrigger explosion.
		return;
	}

	self.has_exploded = True;
}

def crate_tick(self, dt, world, crate_index) {
	if self == world.pushed_crate {
		crate_tick_horizontal_movement(self, dt, world);
		return;
	}

	crate_tick_vertical_movement(self, dt, world, crate_index);
}

# get previous crate in the column. 
# pass crate_index as an argument since we do not know the position of the crate, and I really don't want 
# to refactor compiler to compare references (at least before the deadline).
# TODO refactor to compare objects and lists by reference.
def crate_tick_vertical_movement(self, dt, world, crate_index) {
	crate_column_index = self.previous_goal_x;
	target_y = world_get_floor_level(world, crate_column_index, crate_index);

	self.y = self.y - global(VELOCITY) * dt;
	if self.y < target_y {
		self.y = target_y;
	}
}

def crate_tick_horizontal_movement(self, dt, world) {
	if self.horizontal_movement_kind == None {
		return;
	}

	velocity = global(VELOCITY) * global(DOUBLE_SPEED_VELOCITY_MULTIPLIER) if world.double_speed_timer.is_applied else global(VELOCITY);

	horizontal_movement_float = float(self.horizontal_movement_kind);
	self.x = self.x + horizontal_movement_float * velocity * dt;
	distance_from_goal = (float(self.current_goal_x) - self.x) * horizontal_movement_float;

	if global(MOVEMENT_EPS) >= distance_from_goal {
		# place the crate in the destination column preserving ordering by y 
		world_insert_crate_sorted(world, self, self.current_goal_x);
		
		# update state
		self.x = float(self.current_goal_x);
		self.previous_goal_x = self.current_goal_x;
		self.current_goal_x = None;
		self.horizontal_movement_kind = None;
		world.pushed_crate = None;
	}
}

def crate_get_center(self) {
	vec = {};
	vec.x = self.x + 0.5;
	vec.y = self.y + 0.5;
	return vec;
}

# computes minY, maxY of the crate on the board and returns Interval instance.
def crate_get_y_axis_span(self) {
	y_start = self.y;
	y_end = self.y + global(CRATE_HEIGHT);
	return interval_new(y_start, y_end);
}

# gets scaled extent of the box. This one is used when the box is moved. 
def crate_get_y_span_scaled(self) {
	y_start = self.y;
	y_end = self.y + global(CRATE_HEIGHT);
	return interval_new(y_start+0.02, y_end-0.02);
}


def pick_up_crate_behavior_double_speed(world) {
	print("DOUBLE SPEED ACTIVE");
	world_on_double_speed_activated(world);
}

def pick_up_crate_behavior_give_health(world) {
	world.player.health = min(world.player.health + 1, 3);
}

def pick_up_crate_new(x, y, pick_up_behavior_func) {
	crate = crate_new(x, y);
	crate.on_added_to_board = &pick_up_crate_on_added_to_board;
	crate.move = &pick_up_crate_move;
	crate.draw = &pick_up_crate_draw;
	crate.tick = &pick_up_crate_tick;
	crate.should_despawn = &pick_up_crate_should_despawn;
	crate.on_picked_up = &pick_up_crate_on_picked_up;

	crate.get_player_gravity_behavior = &pick_up_crate_get_player_gravity_behavior;
	crate.pick_up_behavior_func = pick_up_behavior_func;
	crate.pick_up_despawn_timer = timer_new(global(PICK_UP_CRATE_DESPAWN_AFTER));
	crate.picked_up = False;
	return crate;
}

def pick_up_crate_should_despawn(self) {
	return not self.pick_up_despawn_timer.is_applied or crate_should_despawn(self) or self.picked_up;
}

def pick_up_crate_on_picked_up(self) {
	if self.picked_up {
		return;
	}

	self.picked_up = True;
}

def pick_up_crate_on_added_to_board(self) {
	timer_arm(self.pick_up_despawn_timer);
}

def pick_up_crate_get_player_gravity_behavior() {
	return global(CRATE_GRAVITY_BEHAVIOR_PICKUP);
}

def pick_up_crate_tick(self, dt, world, crate_index) {
	timer_tick(self.pick_up_despawn_timer, dt);
	crate_tick(self, dt, world, crate_index);
}


# should rename this to interact
def pick_up_crate_move(self, desired_horizontal_movement_kind, world, row_index) {
	# crate is already moving.
	if self.horizontal_movement_kind != None {
		return False;
	}

	# some crate is being pushed already,.
	if world.pushed_crate != None {
		return False;
	}

	pick_up_crate_on_picked_up(self);
	self.pick_up_behavior_func(world);

	return False;	
}

def pick_up_crate_draw(self) {
	board_height = global(CELL_SIZE) * global(BOARD_CELLS_ALONG_Y);
	cellStartX = global(CELL_SIZE) *  self.x;
	cellStartY = board_height - (global(CELL_SIZE) * self.y);
	RlDrawRectangle(cellStartX, cellStartY, global(CELL_SIZE), global(CELL_SIZE), 255, 0, 0);
}

# EXPLODER CRATE
def exploder_crate_new(x, y) {
	crate = crate_new(x, y);
	crate.on_added_to_board = &exploder_crate_on_added_to_board;
	crate.draw = &exploder_crate_draw;
	crate.tick = &exploder_crate_tick;

	crate.exploder_timer = timer_new(global(EXPLODER_CRATE_EXPLODE_AFTER));
	return crate;
}

def exploder_crate_on_added_to_board(self) {
	timer_arm(self.exploder_timer);
}

def exploder_crate_draw(self) {
	# should probably extract this coordinates computation to a function. TODO
	board_height = global(CELL_SIZE) * global(BOARD_CELLS_ALONG_Y);
	cellStartX = global(CELL_SIZE) *  self.x;
	cellStartY = board_height - (global(CELL_SIZE) * self.y);
	RlDrawRectangle(cellStartX, cellStartY, global(CELL_SIZE), global(CELL_SIZE), 255, 0, 255);
}

def exploder_crate_tick(self, dt, world, crate_index) {
	timer_tick(self.exploder_timer, dt);
	if not self.exploder_timer.is_applied and not self.has_exploded {
		print("Exploder crate exploded! boom!");
		
		r = global(EXPLODER_CRATE_EXPLOSION_RADIUS);
		x_span = interval_new(self.x - r, self.x + r);
		y_span = interval_new(self.y - r, self.y + r);

		self.explode(self);
		world_explode_all_in_bounding_box(world, x_span, y_span);
		#self.explode(self);
	}

	crate_tick(self, dt, world, crate_index);
}


# CRANE  
def crane_new(x, y, goal_x, horizontal_movement_kind, crate) {
	crane = {};
	crane.x = x;
	crane.y = y;
	crane.previous_goal_x = x; 
	crane.current_goal_x = goal_x;
	crane.horizontal_movement_kind = horizontal_movement_kind;
	crane.crate = crate;

	crane.tick = &crane_tick;
	crane.draw = &crane_draw;
	crane.get_x_axis_span = &crane_get_x_axis_span;
	return crane;
}

def crane_get_x_axis_span(self) {
	x_start = self.x;
	x_end = self.x + global(CRATE_HEIGHT);
	return interval_new(x_start, x_end);
}

# self = crane.
def crane_tick(self, dt, world) {
	horizontal_movement_float = float(self.horizontal_movement_kind);
	self.x = self.x + horizontal_movement_float * global(VELOCITY) * dt;
	distance_from_goal = (float(self.current_goal_x) - self.x) * horizontal_movement_float;

	if self.crate != None {
		self.crate.set_position(self.crate, self.x, self.y);
	}


	if global(MOVEMENT_EPS) >= distance_from_goal {
		if not board_x_coordinate_in_bounds(self.current_goal_x) {
			# should despawn the crate at this point.
			return False;
		}

		if self.crate == None {
			return False;
		}

		able_to_spawn = True;

		# have the column reached its maximum occupancy?
		if world_get_count_in_column(world, self.current_goal_x) >= global(BOARD_CELLS_ALONG_Y)  {
			able_to_spawn = able_to_spawn and False;
		}

		# does it overlap any crates?
		span = self.crate.get_y_axis_span(self);
		span.min = span.min - 1.5; # should have some space between crates probably.
		able_to_spawn = able_to_spawn and not world_interval_overlaps_topmost_crate_in_column(world, span, self.current_goal_x);

		if not able_to_spawn {
			self.current_goal_x = crate_get_offboard_destination(self.horizontal_movement_kind);
			return False;
		}

		crate = self.crate; 
		crate.x = float(self.current_goal_x);
		crate.previous_goal_x = self.current_goal_x;
		self.crate = None;

		# get the crane off the board.
		self.current_goal_x = crate_get_offboard_destination(self.horizontal_movement_kind);

		world_append_crate(world, crate.previous_goal_x, crate);
		crate.on_added_to_board(crate);
	}
}

def crane_draw(self) {
	if self.crate != None {
		self.crate.draw(self.crate);
	}

	board_height = global(CELL_SIZE) * global(BOARD_CELLS_ALONG_Y);
	cell_start_x = global(CELL_SIZE) *  self.x;
	cell_start_y = board_height - (global(CELL_SIZE) * self.y); 

	width = global(CELL_SIZE);
	height = 32; 

	RlDrawRectangle(cell_start_x, cell_start_y, width, height, 0, 0, 255);
}



# WORLD object.
# Is a collection of columns containing crates.
# Also contains player instance.
# All crates in columns are sorted by y coordinate.
def world_new() {
	columns = [];
	x = 0;
	while x < global(BOARD_CELLS_ALONG_X) {
		columns = columns + [];
		x = x + 1;
	}


	crate1 = crate_new(8, 0);
	crate2 = crate_new(2, 0);
	crate3 = crate_new(4, 0);
	columns[8] = columns[8] + crate1;
	columns[2] = columns[2] + crate2;
	columns[4] = columns[4] + crate3;
	
	
	world = {};
	world.queue = 0; # number of crates that are queued to spawn.
	world.columns = columns;
	world.cranes_left= [];
	world.cranes_right = [];
	world.player = player_new(0, 0);
	world.pushed_crate = None;
	world.interval_overlaps_any_in_column = &world_interval_overlaps_any_in_column;
	world.get_highest_in_column_below = &world_get_highest_in_column_below;
	world.score = 0;
	world.crate_spawn_timer = timer_new(global(INITIAL_CRATE_SPAWN_TIMER));
	world.double_speed_timer = timer_new(global(DOUBLE_SPEED_DURATION));
	return world;
}

def world_enqueue_crate_spawn(self) {
	self.queue = min(self.queue + 1, 14);
}

def world_try_destroy_bottom_row(self) {
	target_row_y = 0;

	x = 0;
	while x < len(self.columns) {
		col = self.columns[x];
		if len(col) == 0 {
			return;
		}

		bottom_most_crate = col[0];
		if abs(bottom_most_crate.y - target_row_y) >= global(MOVEMENT_EPS) {
			return;
		}

		x = x + 1;
	}

	# looking good, can remove row
	x = 0;
	while x < len(self.columns) {
		column = self.columns[x];
		crate = column[0];
		crate.explode(crate);
		x = x + 1;
	}

	self.score = self.score + global(SCORE_PER_CRATE_DESTROYED) * global(BOARD_CELLS_ALONG_X);
}

def world_on_double_speed_activated(self) {
	timer_arm(self.double_speed_timer);
}

def _world_tick_cranes(self, cranes, dt) {
	remaining_cranes = [];
	c = 0; 
	while c < len(cranes) {
		crane = cranes[c];
		crane.tick(crane, dt, self);

		if board_x_coordinate_in_bounds_with_margin(crane.x) {
			remaining_cranes = remaining_cranes + crane;
		}

		c = c + 1;
	}

	return remaining_cranes;
}

def world_tick(self, dt) {

	player_check_death_condition(self.player, self);
	world_try_destroy_bottom_row(self);
	timer_tick(self.crate_spawn_timer, dt);
	timer_tick(self.double_speed_timer, dt);
	world_spawn_crate_2(self);

	self.cranes_left = _world_tick_cranes(self, self.cranes_left, dt);
	self.cranes_right = _world_tick_cranes(self, self.cranes_right, dt);

	self.player.tick(self.player, dt, self);

	if self.pushed_crate != None {
		if self.pushed_crate.should_despawn(self.pushed_crate) {
			self.pushed_crate = None;
		}
	}

	if self.pushed_crate != None {
		self.pushed_crate.tick(self.pushed_crate, dt, self, -1);
	}


	# tick crates in all columns
	x = 0;
	while x < len(self.columns) {
		column = self.columns[x];
		new_column = [];
		y = 0;
		while y < len(column) {
			crate = column[y];
			crate.tick(crate, dt, self, y);
			if not crate.should_despawn(crate) {
				new_column = new_column + crate;
			}
			y = y + 1;
		}
		self.columns[x] = new_column;
		x = x + 1;
	}


	if self.player.liveness != None {
		return;
	}

	# crate spawning, this is pretty bad though, but not much time left.
	initial_crate_spawn_chance = global(INITIAL_CRATE_RANDOM_SPAWN_CHANCE);

	if self.score >= 12 {
		self.crate_spawn_timer.default_duration = global(INITIAL_CRATE_SPAWN_TIMER ) - 1.0;
		initial_crate_spawn_chance = global(INITIAL_CRATE_RANDOM_SPAWN_CHANCE) + 0.0002;
	}

	if self.score >= 24 {
		self.crate_spawn_timer.default_duration = global(INITIAL_CRATE_SPAWN_TIMER) - 2.0;
		initial_crate_spawn_chance = global(INITIAL_CRATE_RANDOM_SPAWN_CHANCE) + 0.0005;
	}

	if self.score >= 48 {
		self.crate_spawn_timer.default_duration = global(INITIAL_CRATE_SPAWN_TIMER) - 2.5;
		initial_crate_spawn_chance = global(INITIAL_CRATE_RANDOM_SPAWN_CHANCE) + 0.001;
	}

	if self.score >=72 {
	self.crate_spawn_timer.default_duration = global(INITIAL_CRATE_SPAWN_TIMER) - 3.0;
	initial_crate_spawn_chance = global(INITIAL_CRATE_RANDOM_SPAWN_CHANCE) + 0.002;
	}

	if self.score > 96 {
		self.crate_spawn_timer.default_duration = global(INITIAL_CRATE_SPAWN_TIMER) - 3.5;
		initial_crate_spawn_chance = global(INITIAL_CRATE_RANDOM_SPAWN_CHANCE) + 0.006;
	}

	crate_spawn_chance = random_float();
	if not self.crate_spawn_timer.is_applied or crate_spawn_chance < initial_crate_spawn_chance {
		world_enqueue_crate_spawn(self);
		timer_arm(self.crate_spawn_timer);
	}
}

def _world_can_spawn_crane(self, arr, new_crane_span) {
	i = 0;	
	while i < len(arr) {
		crane = arr[i];
		crane_span = crane.get_x_axis_span(crane);
		if intervals_overlap(new_crane_span, crane_span) {
			return False;
		}
		i = i + 1;
	}

	return True;
}

def _world_pick_crate_kind_to_spawn(x, y) {
	if random_float() < 0.05 {
		#return pick_up_crate_new(x, y, &pick_up_crate_behavior_double_speed);
		#return pick_up_crate_new(x, y, &pick_up_crate_behavior_give_health);
		return exploder_crate_new(x, y);
	}

	return crate_new(x, y);
}

def world_spawn_crate_2(self) {
	if self.queue == 0 {
		return;
	}

	goal_column = _world_get_column_candidates(self);
	if goal_column == None {
		return;
	}


	x = -global(BOARD_CRATE_EXIT_MARGIN);
	y = global(BOARD_CELLS_ALONG_Y) + 2;

	crane_left  = crane_new(x, y, goal_column, global(HORIZONTAL_MOVEMENT_RIGHT), _world_pick_crate_kind_to_spawn(x, y));

	x = global(BOARD_CELLS_ALONG_X) + global(BOARD_CRATE_EXIT_MARGIN);
	y = global(BOARD_CELLS_ALONG_Y) + 2;
	crane_right = crane_new(x, y, goal_column, global(HORIZONTAL_MOVEMENT_LEFT), _world_pick_crate_kind_to_spawn(x, y));


	a = _world_can_spawn_crane(self, self.cranes_left, crane_left.get_x_axis_span(crane_left));
	b = _world_can_spawn_crane(self, self.cranes_right, crane_right.get_x_axis_span(crane_right));

	print("GOAL " + goal_column);

	if (a and b) {
		r = random_float();
		if r < 0.5 {
			self.queue = max(self.queue - 1, 0);
			self.cranes_left = self.cranes_left + crane_left;
		} else {
			self.queue = max(self.queue - 1, 0);
			self.cranes_right =  self.cranes_right + crane_right;
		}
		return;
	}

	if (a) {
		self.queue = max(self.queue - 1, 0);
		self.cranes_left = self.cranes_left + crane_left;
		return;
	}

	if (b) {
		self.queue = max(self.queue - 1, 0);
		self.cranes_right = self.cranes_right + crane_right;
		return;
	}

	# cannot spawn crates here.
}

# get all crate spawn candidates, this includes the crates that have already spawned.
# inspect their current_goal_x
def _world_get_column_candidates(self) {
	column_index = 0;

	# get number of crates in the column 
	number_of_crates_per_column = [];
	while column_index < global(BOARD_CELLS_ALONG_X) {
		column = self.columns[column_index];
		number_of_crates_per_column  = number_of_crates_per_column  + len(column);
		column_index = column_index + 1;
	}

	# take into account also the ones that have been spawned but yet to be delivered to the destination column
	ci = 0;
	while ci < len(self.cranes_left) {
		crane = self.cranes_left[ci];
		crate_destination_column = crane.current_goal_x;
		if board_x_coordinate_in_bounds(crate_destination_column) {
			number_of_crates_per_column[crate_destination_column] = number_of_crates_per_column[crate_destination_column] + 1;
		}
		ci = ci + 1;
	}


	ci = 0;
	while ci < len(self.cranes_right) {
		crane = self.cranes_right[ci];
		crate_destination_column = crane.current_goal_x;
		if board_x_coordinate_in_bounds(crate_destination_column) {
			number_of_crates_per_column[crate_destination_column] = number_of_crates_per_column[crate_destination_column] + 1;
		}
		ci = ci + 1;
	}

	# now, get an array of column indices that does not exceed CELLS_ALONG_Y_AXIS

	candidate_column_indices = [];

	ci = 0;
	while ci < len(number_of_crates_per_column) {
		if number_of_crates_per_column[ci] < global(BOARD_CELLS_ALONG_Y) {
			candidate_column_indices = candidate_column_indices + ci;
		}
		ci = ci + 1;
	}

	if len(candidate_column_indices) == 0 {
		return None;
	}

	r = random_int(len(candidate_column_indices));
	return candidate_column_indices[r];
}

# returns a list of crates that overlap provided interval in a column with columnIndex.
def world_interval_overlaps_any_in_column(self, interval, column_index) {
	assert(board_x_coordinate_in_bounds(column_index)); # TODO we should really have messages here.

	column = self.columns[column_index];

	overlapping_crates = [];

	i = 0;
	while i < len(column) {
		crate = column[i];
		crate_interval = crate.get_y_axis_span(crate);

		if intervals_overlap(interval, crate_interval) {
			overlap_info = {};
			overlap_info.index = i;
			overlap_info.crate = crate;
			overlapping_crates = overlapping_crates + overlap_info;
		}
		i = i + 1;
	}

	return overlapping_crates;
}

def world_get_count_in_column(self, column_index) {
	return len(self.columns[column_index]);
}

def world_interval_overlaps_topmost_crate_in_column(self, interval, column_index) {
	column = self.columns[column_index];
	if len(column) == 0 {
		return False;
	}

	last_crate = column[len(column)-1];
	last_crate_interval = last_crate.get_y_axis_span(last_crate);
	return intervals_overlap(interval, last_crate_interval);
}

def world_insert_crate_sorted(self, crate, column_index) {
	destination_column = self.columns[column_index];

		highest = -1;
		highest_index = -1;
		i = 0;
		while i < len(destination_column) {
			crate_in_destination_column = destination_column[i];
			if crate.y > crate_in_destination_column.y and crate_in_destination_column.y > highest {
				highest = crate_in_destination_column.y;
				highest_index = i; 
			}
			i = i + 1;
		}

		self.columns[column_index] = list_insert_after_index(destination_column, highest_index, crate);
		# TODO fix y coordinates after insertion?
}

# returns y-coordinate of the crate is highest y below supplied y.
# For example, given below_y = 5 and ys = [7, 4, 3, 1], 4 should be returned
# TODO this name is confusing AF.
def world_get_highest_in_column_below(self, below_y, column_index) {
	assert(board_x_coordinate_in_bounds(column_index)); # TODO we should really have messages here.
	#print(below_y);
	#print(column_index);

	column = self.columns[column_index];

	highest = 0;
	highest_index = -1;
	highest_crate = None;

	i = 0;
	while i < len(column) {
		crate = column[i];
		box_bottom_y = crate.y;
		box_top_y = crate.y + global(CRATE_HEIGHT);
		if below_y >= box_top_y {
			if box_top_y > highest {
				highest = box_top_y;
				highest_index = i;
				highest_crate = crate;
			}
		}

		# So this whole thing is used to prevent objects from sinking into each other
		# Player may provide movement inputs such that player_movement succeeds (due to player's interval being scaled and slightly shorter)
		# but his real y coordinate is lower hence he might has sunk into the crate underneath him. 
		# For this, we detect if player's y overlaps the box interval set that as highest crate in the stack.
		# TODO I am not entirely sure this margin computation is worth it though? (Do we even) want to find out by how much player is sinking?
		if below_y >= box_bottom_y and box_top_y >= below_y {
			l = lerp_find_t(box_bottom_y, box_top_y, below_y); # in [0, 1] range
			margin_from_top = 1 - global(MOVEMENT_EPS) * 10;
			if l > margin_from_top  {
				if box_top_y > highest {
					highest = box_top_y;
					highest_index = i;
					highest_crate = crate;
				}
			}
		}

		i = i + 1;
	}

	ret = {};
	ret.crate_index = highest_index;
	ret.column_index = column_index;
	ret.crate_y = highest;
	ret.crate = highest_crate;
	return ret;

}


# returns index of the lowest crate after given y.
# For example, given after_y= 5 and ys = [0, 1, 3, 5, 9], 3 should be returned (3 is index of 5)
def world_get_lowest_in_column_after(self, after_y, column_index) {
	assert(board_x_coordinate_in_bounds(column_index)); # TODO we should really have messages here.
	column = self.columns[column_index];

	lowest = 9999.0; #yuck
	lowest_index = -1;
	lowest_crate = None;

	i = len(column) - 1; 
	while i >= 0 {
		crate = column[i];
		crate_bottom_y = crate.y;
		crate_top_y = column[i].y + global(CRATE_HEIGHT);

		if after_y < crate_bottom_y {
			if crate_bottom_y < lowest {
				lowest = crate_bottom_y; 
				lowest_index = i;
				lowest_crate = crate;	
			}
		}

		# apply sinking logic (see above)
		if after_y >= crate_bottom_y and crate_top_y >= after_y {
			if crate_bottom_y < lowest {
				lowest = crate_bottom_y; 
				lowest_index = i;
				lowest_crate = crate;	
			}
			#l = lerp_find_t(crate_bottom_y, crate_top_y, after_y); # in [0, 1] range
			#margin_from_bottom = global(MOVEMENT_EPS) * 10;
			#if l < margin_from_bottom {
			#}
		}

		i = i - 1;
	}

	ret = {};
	ret.crate_index = lowest_index;
	ret.column_index = column_index;
	ret.crate_y = lowest;
	ret.crate = lowest_crate;
	return ret;
}

# get floor level for crate in column x at index crate_index.
# This takes pushed crate into account.
def world_get_floor_level(self, x, crate_index)  {
	assert(crate_index >= 0);
	column = self.columns[x];
	this_crate = column[crate_index];

	target_y = 0.0;
	if crate_index > 0 {
		previous_crate = column[crate_index-1];
		target_y = previous_crate.y + global(CRATE_HEIGHT);
	}

	# need to take pushed crate into account
	pushed_crate = self.pushed_crate;
	if pushed_crate == None {
		return target_y;
	}

	if pushed_crate.previous_goal_x == x or pushed_crate.current_goal_x == x {
		# TODO this crate_top thing should be extracted into its own function.
		# (although we don't really change crate size ever.)
		pushed_crate_top = pushed_crate.y + global(CRATE_HEIGHT); 
		if pushed_crate_top < this_crate.y or pushed_crate_top < this_crate.y+global(CRATE_HEIGHT) {
			target_y = max(target_y, pushed_crate_top);
		}
	}

	return target_y;
}

def world_explode_all_in_bounding_box(self, x_span, y_span) {
	xmin = max(floor(x_span.min), 0);
	xmax = min(ceil(x_span.max), global(BOARD_CELLS_ALONG_X) - 1);
	print("Exploding stuff in columns " + xmin + " " + xmax);

	x = xmin;
	while x <= xmax {
		column = self.columns[x];

		y = 0;
		while y < len(column) {
			crate = column[y];
			crate_center = crate.get_center(crate);
			print("Interval " + y_span + " " + crate_center.y);
			if interval_contains_point(y_span, crate_center.y) {
				crate.explode(crate);
			}

			y = y + 1;
		}

		x = x + 1;
	}
}

def world_append_crate(self, column_index, crate) {
	if not board_x_coordinate_in_bounds(column_index) {
		assert(False);
	}

	self.columns[column_index] = self.columns[column_index] + crate;
}

def world_draw(self) {
	c = 0;
	while c < len(self.cranes_left) {
		crane = self.cranes_left[c];
		crane.draw(crane);
		c = c + 1;
	}

	c = 0;
	while c < len(self.cranes_right) {
		crane = self.cranes_right[c];
		crane.draw(crane);
		c = c + 1;
	}

	columnIndex = 0;
	while columnIndex < len(self.columns) {
		column = self.columns[columnIndex];

		rowIndex = 0;
		while rowIndex < len(column) {
			crate = column[rowIndex];
			crate.draw(crate);
			rowIndex = rowIndex + 1;
		}

		columnIndex = columnIndex + 1;
	}

	if self.pushed_crate != None {
		self.pushed_crate.draw(self.pushed_crate);
	}

	self.player.draw(self.player);
}



def main() {
	RlInitWindow(global(SCREEN_WIDTH), global(SCREEN_HEIGHT));
	RlSetTargetFPS(60);

	# TODO should introduce load assets function.
	crate_tex = RlLoadTexture("stacking-trouble-game/assets/crate1.png");

	asset_registry = global(ASSET_REGISTRY);

	asset_registry.crate = crate_tex;


	world = world_new();

	current_time_ms = time();
	dt  = 0.01;
	accumulator = 0.0;


	while not RlWindowShouldClose() {
		if RlIsKeyReleased(global(RL_KEY_ENTER)) {
			accumulator = 0.0;
			world = world_new();
		}

		if RlIsKeyDown(global(RL_KEY_SPACE)) {
			world.player.jump(world.player);
		}

		if RlIsKeyDown(global(RL_KEY_LEFT)) {
			world.player.move(world.player, global(HORIZONTAL_MOVEMENT_LEFT), world);
		}

		if RlIsKeyDown(global(RL_KEY_RIGHT)) {
			world.player.move(world.player, global(HORIZONTAL_MOVEMENT_RIGHT), world);
		}


		# physics main loop, shamlessly stolen from Gaffer On Games Fix your timestep 
		# we don't do any interpolation between states though.
		new_time_ms = time();
		frame_time = (new_time_ms - current_time_ms) / 1000.0;
		current_time_ms = new_time_ms;

		accumulator = accumulator + frame_time ;

		while dt < accumulator {
			world_tick(world, dt);
			accumulator = accumulator - dt;
		}

		RlBeginDrawing();
		RlClearBackground(230, 230, 230);


		RlBeginMode2D(global(BOARD_CAMERA));

		world_draw(world);

		RlEndMode2D();

		RlDrawText("Score: " + world.score, 10, 10, 40, 255,0,0);
		RlDrawText("Healh: " + world.player.health, 300, 10, 40, 255,0,0);


		if world.player.liveness == global(PLAYER_LIVENESS_DEAD){
			RlDrawText("Game Over" , 270, 300, 40, 255,0,0);
			RlDrawText("(press enter to restart)" , 300, 350, 20, 255,0,0);
		}
		RlEndDrawing();
	}

	RlUnloadTexture(crate_tex);
	RlCloseWindow();
}

