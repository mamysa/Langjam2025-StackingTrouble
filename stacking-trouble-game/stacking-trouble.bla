# loads animation frames from some directory.
# Iterates from startingFrameNumber to endingFrameNumber, generates filename + frame + extension, does RlLoadTexture and 
# returns a list containing loaded textures.
# This texture array can be unloaded with texture_array_unload
def _load_animation_from_directory(directory, filename, startingFrameNumber, endingFrameNumber, extension) {
	arr = [];

	i = startingFrameNumber;
	while i <= endingFrameNumber {
		filepath = directory + filename + i + extension;
		print("Loading " + filepath);
		frame = RlLoadTexture(filepath);
		arr = arr + frame;
		i = i + 1;
	}

	return arr;
}

def asset_registry_pick_explosion_animation() {
	ar = global(ASSET_REGISTRY);
	return ar.explosion_1 if random_float() < 0.5 else ar.explosion_2;
}

def unload_assets() {
	asset_registry = global(ASSET_REGISTRY);

	texture_array_unload(asset_registry.hardhat_dude_idle);
	texture_array_unload(asset_registry.hardhat_dude_walk_right);
	texture_array_unload(asset_registry.hardhat_dude_push_right);
	texture_array_unload(asset_registry.hardhat_dude_walk_left);
	texture_array_unload(asset_registry.hardhat_dude_push_left);

	texture_array_unload(asset_registry.crates);
	texture_array_unload(asset_registry.explosion_1);
	texture_array_unload(asset_registry.explosion_2);

	RlUnloadTexture(asset_registry.wall_pillar_left);
	RlUnloadTexture(asset_registry.wall_pillar_right);
	RlUnloadTexture(asset_registry.wall);
	RlUnloadTexture(asset_registry.floor);
	RlUnloadTexture(asset_registry.crane);

	RlUnloadTexture(asset_registry.exploder_crate);
	RlUnloadTexture(asset_registry.health_crate);
	RlUnloadTexture(asset_registry.double_speed_crate);

	RlUnloadTexture(asset_registry.icon_heart);
	RlUnloadTexture(asset_registry.icon_double_speed);
}


# Physics ticker class. Maintains frametimes, delta times, and invokes a callback with delta time when 
# appropriate
def physics_ticker_new() {
	ticker = {};
	ticker.previous_time_ms = time();
	ticker.accumulator = 0.0;
	return ticker;
}

# self = physics_ticker
# object must contain tick(obj, dt) method.
def physics_ticker_tick(self, obj) {
	dt  = 0.01;
	new_time_ms = time();
	frame_time = (new_time_ms - self.previous_time_ms) / 1000.0;
	self.previous_time_ms = new_time_ms;
	self.accumulator = self.accumulator + frame_time;

	while dt < self.accumulator {
		obj.tick(obj, dt);
		self.accumulator = self.accumulator - dt;
	}
}


# Game state object.
# What state is the game in? E.g. splash-screen / tutorial / actual game.
def main_game_state_new() {
	game_state = {};
	game_state.world =	world_new(5, 0, True); 
	game_state.run = &_main_game_state_run;
	game_state.physics_ticker = physics_ticker_new(); 
	game_state.is_paused = False;
	return game_state;
}

def _main_game_state_toggle_pause(self) {
	if self.world.player.liveness == global(PLAYER_LIVENESS_DEAD){
	# do not allow to pause when player is dead.
		return;
	}

	self.is_paused = not self.is_paused;
	if not self.is_paused {
		self.physics_ticker = physics_ticker_new();
	}
}

def _main_game_state_run(self, game) {
	_main_game_state_handle_input(self);

	if not self.is_paused {
		_main_game_state_do_physics(self);
	}

	_main_game_state_draw(self);
}

def _main_game_state_handle_input(self) {

	if RlIsKeyReleased(global(RL_KEY_P)) {
		_main_game_state_toggle_pause(self);
	}

	if self.is_paused {
		# do not accept any inputs aside from unpause button.
		return;
	}


	if RlIsKeyReleased(global(RL_KEY_ENTER)) {
		self.physics_ticker = physics_ticker_new();
		self.world = world_new(5, 0, True);
	}


	p = self.world.player;
	p.move(p, None, self.world);

	if RlIsKeyDown(global(RL_KEY_SPACE)) {
		p.jump(p);
	}

	if RlIsKeyDown(global(RL_KEY_LEFT)) {
		p.move(p, global(HORIZONTAL_MOVEMENT_LEFT), self.world);
	}

	if RlIsKeyDown(global(RL_KEY_RIGHT)) {
		p.move(p, global(HORIZONTAL_MOVEMENT_RIGHT), self.world);
	}
}

def _main_game_state_do_physics(self) {
	physics_ticker_tick(self.physics_ticker, self.world);
}

def _main_game_state_draw(self) {
	RlBeginMode2D(global(BOARD_CAMERA));
	world_draw(self.world);
	RlEndMode2D();

	
	#RlDrawText("Score: " + self.world.score, 10, 10, 40, 255,0,0);
	#RlDrawText("Health: " + self.world.player.health, 300, 10, 40, 255,0,0);

	draw_hud(self.world.score, self.world.player.health, self.world.double_speed_timer.is_applied);

	if self.world.player.liveness == global(PLAYER_LIVENESS_DEAD){
		RlDrawText("Game Over" , 270, 300, 40, 255,0,0);
		RlDrawText("(press enter to restart)" , 300, 350, 20, 255,0,0);
	}

	if self.is_paused {
		RlDrawRectangle(0, 0, global(SCREEN_WIDTH), global(SCREEN_HEIGHT), 0, 0, 0, 100);
		RlDrawText("Paused" , 300, 270, 40, 255,0,0);

	}
}

# Tutorial game state
# All actual tutorial setup/drawing will be done in objects implementing tick/draw methods.
# This way we will be able to switch/reset tutorial stages on keypress (including various input timers.)
def tutorial_game_state_new() {
	game_state = {};
	game_state.run = &_tutorial_game_state_run;
	game_state.physics_ticker = physics_ticker_new(); 
	game_state.tutorial_stage = tutorial_stage_1();
	game_state.tick = &_tutorial_game_state_tick;

	game_state.tutorial_stage_2_timer = timer_new(11); #11
	game_state.tutorial_stage_2_active = False;

	game_state.tutorial_stage_3_timer = timer_new(31); #31
	game_state.tutorial_stage_3_active = False;

	game_state.tutorial_stage_4_timer = timer_new(42); #42
	game_state.tutorial_stage_4_active = False;

	game_state.back_to_splashscreen_timer = timer_new(72); #69
	game_state.back_to_main_menu_active = False;

	timer_arm(game_state.tutorial_stage_2_timer);
	timer_arm(game_state.tutorial_stage_3_timer);
	timer_arm(game_state.tutorial_stage_4_timer);
	timer_arm(game_state.back_to_splashscreen_timer);
	return game_state;
}

def _tutorial_game_state_tick(self, dt) {
	timer_tick(self.tutorial_stage_2_timer, dt);
	timer_tick(self.tutorial_stage_3_timer, dt);
	timer_tick(self.tutorial_stage_4_timer, dt);
	timer_tick(self.back_to_splashscreen_timer, dt);
	self.tutorial_stage.tick(self.tutorial_stage, dt);

	if not self.tutorial_stage_2_timer.is_applied and not self.tutorial_stage_2_active {
		self.tutorial_stage = tutorial_stage_2();
		self.tutorial_stage_2_active = True;
	}

	if not self.tutorial_stage_3_timer.is_applied and not self.tutorial_stage_3_active {
		self.tutorial_stage = tutorial_stage_3();
		self.tutorial_stage_3_active = True;
	}

	if not self.tutorial_stage_4_timer.is_applied and not self.tutorial_stage_4_active {
		self.tutorial_stage = tutorial_stage_4();
		self.tutorial_stage_4_active = True;
	}
}


def _tutorial_game_state_run(self, game) {
	physics_ticker_tick(self.physics_ticker, self);
	self.tutorial_stage.draw(self.tutorial_stage);


	if not self.back_to_splashscreen_timer.is_applied and not self.back_to_main_menu_active {
		game.set_splashscreen_state(game);
		self.back_to_main_menu_active = True;
	}
}


# Tutorial Stage 1 - explaining basics of the game
def tutorial_stage_1() {
	# setup the world. This is all very board size dependent so will probably break if board size is changed...
	ar = global(ASSET_REGISTRY);
	cells_x = global(BOARD_CELLS_ALONG_X);

	lx = clamp(0, cells_x, int(cells_x * 0.45));
	rx = clamp(0, cells_x, lx + 1);

	world = world_new(lx-2, 2, False);
	
	x = 0;
	while x < lx {
		crate_tex = random_int(len(ar.crates));
		col = world.columns[x];
		col = col + crate_new(x, 0, ar.crates[crate_tex]);
		world.columns[x] = col;
		x = x + 1;
	}

	x = rx;
	while x < cells_x {
		crate_tex = random_int(len(ar.crates));
		crate_tex_2 = random_int(len(ar.crates));
		col = world.columns[x];
		col = col + crate_new(x, 0, ar.crates[crate_tex]);
		if random_float() < 0.5 {
			col = col + crate_new(x, 1, ar.crates[crate_tex_2]);
		}
		world.columns[x] = col;
		x = x + 1;
	}


	t = {};
	t.tick = &_tutorial_stage_1_tick;
	t.draw = &_tutorial_stage_1_draw;
	t.world = world;
	t.crate_spawn_column = lx - 1;

	# crate spawn timer
	t.crate_spawn_timer = timer_new(1);
	t.crate_spawned = False;
	timer_arm(t.crate_spawn_timer);

	t.player_move_timer = timer_new(8);
	t.player_moved = False;
	timer_arm(t.player_move_timer);


	return t;
}

def _tutorial_stage_1_tick(self, dt) {
	world_tick(self.world, dt);
	timer_tick(self.crate_spawn_timer, dt);
	timer_tick(self.player_move_timer, dt);

	if not self.crate_spawn_timer.is_applied and not self.crate_spawned {
		ar = global(ASSET_REGISTRY);
		crate_tex = random_int(len(ar.crates));
		w = self.world;
		w.columns[self.crate_spawn_column] = w.columns[self.crate_spawn_column] + crate_new(self.crate_spawn_column, global(BOARD_CELLS_ALONG_Y)+4, ar.crates[crate_tex]);
		self.crate_spawned = True;
	}

	if not self.player_move_timer.is_applied and not self.player_moved {
		self.world.player.move(self.world.player, global(HORIZONTAL_MOVEMENT_RIGHT), self.world);
		self.player_moved = True;
	}
}

def _tutorial_stage_1_draw(self) {
	RlBeginMode2D(global(BOARD_CAMERA));
	world_draw(self.world);
	RlEndMode2D();
	draw_hud(self.world.score, self.world.player.health, self.world.double_speed_timer.is_applied);
	draw_text_widget(550, 220, 400, 190, global(TUTORIAL_STAGE_1_TEXT));
}


# Stage 2 - jumping.
def tutorial_stage_2() {
	world = world_new(2, 0, False);
	t = {};
	t.tick = &_tutorial_stage_2_tick;
	t.draw = &_tutorial_stage_2_draw;
	t.world = world;
	t.crate_spawn_column = 2;

	t.text2_timer = timer_new(6);
	t.text2_timer_done = False;
	timer_arm(t.text2_timer);

	t.text3_timer = timer_new(9);
	t.text3_timer_done = False;
	timer_arm(t.text3_timer);

	t.text4_timer = timer_new(14);
	t.text4_timer_done = False;
	timer_arm(t.text4_timer);

	t.crate_1_spawn_timer = timer_new(1);
	t.crate_1_spawned = False;
	timer_arm(t.crate_1_spawn_timer);

	t.crate_2_spawn_timer = timer_new(3.5);
	t.crate_2_spawned = False;
	timer_arm(t.crate_2_spawn_timer);


	t.health_crate_spawn_timer = timer_new(9);
	t.health_crate_spawned = False;
	timer_arm(t.health_crate_spawn_timer);
	

	t.crate_3_spawn_timer = timer_new(14);
	t.crate_3_spawned = False;
	timer_arm(t.crate_3_spawn_timer);


	t.player_jump_timer = timer_new(18);
	t.player_jumped = False;
	timer_arm(t.player_jump_timer);


	t.text_index = 1;

	return t;
}

def _tutorial_stage_2_tick(self, dt) {
	world_tick(self.world, dt);
	timer_tick(self.crate_1_spawn_timer, dt);
	timer_tick(self.crate_2_spawn_timer, dt);
	timer_tick(self.health_crate_spawn_timer, dt);
	timer_tick(self.crate_3_spawn_timer, dt);
	timer_tick(self.player_jump_timer, dt);
	timer_tick(self.text2_timer, dt);
	timer_tick(self.text3_timer, dt);
	timer_tick(self.text4_timer, dt);


	if not self.text2_timer.is_applied and not self.text2_timer_done {
		self.text_index = 2;
		self.text2_timer_done = True;
	}

	if not self.text3_timer.is_applied and not self.text3_timer_done {
		self.text_index = 3;
		self.text3_timer_done = True;
	}

	if not self.text4_timer.is_applied and not self.text4_timer_done {
		self.text_index = 4;
		self.text4_timer_done = True;
	}


	ar = global(ASSET_REGISTRY);
	crate_tex = ar.crates[random_int(len(ar.crates))];
	w = self.world;

	if not self.crate_1_spawn_timer.is_applied and not self.crate_1_spawned {
		w.columns[self.crate_spawn_column] = w.columns[self.crate_spawn_column] + crate_new(self.crate_spawn_column, global(BOARD_CELLS_ALONG_Y)+4, crate_tex);
		self.crate_1_spawned = True;
	}


	if not self.crate_2_spawn_timer.is_applied and not self.crate_2_spawned {
		w.columns[self.crate_spawn_column] = w.columns[self.crate_spawn_column] + crate_new(self.crate_spawn_column, global(BOARD_CELLS_ALONG_Y)+4, crate_tex);
		self.crate_2_spawned = True;
	}


	if not self.health_crate_spawn_timer.is_applied and not self.health_crate_spawned {
		hc = pick_up_crate_new(self.crate_spawn_column, global(BOARD_CELLS_ALONG_Y)+4, &pick_up_crate_behavior_give_health, ar.health_crate);
		w.columns[self.crate_spawn_column] = w.columns[self.crate_spawn_column] + hc;
		hc.on_added_to_board(hc);
		self.health_crate_spawned = True;
	}


	if not self.crate_3_spawn_timer.is_applied and not self.crate_3_spawned {
		w.columns[self.crate_spawn_column] = w.columns[self.crate_spawn_column] + crate_new(self.crate_spawn_column, global(BOARD_CELLS_ALONG_Y)+4, crate_tex);
		self.crate_3_spawned = True;
	}


	if not self.player_jump_timer.is_applied and not self.player_jumped {
		w.player.jump(w.player);
		self.player_jumped = True;
	}
}

def _tutorial_stage_2_draw(self) {
	RlBeginMode2D(global(BOARD_CAMERA));
	world_draw(self.world);
	RlEndMode2D();
	draw_hud(self.world.score, self.world.player.health, self.world.double_speed_timer.is_applied);

	if self.text_index == 1 {
		draw_text_widget(550, 220, 400, 220, global(TUTORIAL_STAGE_2_TEXT_1));
	}

	if self.text_index == 2 {
		draw_text_widget(550, 220, 400, 70, global(TUTORIAL_STAGE_2_TEXT_2));
	}

	if self.text_index == 3 {
		draw_text_widget(550, 220, 400, 100, global(TUTORIAL_STAGE_2_TEXT_3));
	}

	if self.text_index == 4 {
		draw_text_widget(550, 220, 400, 130, global(TUTORIAL_STAGE_2_TEXT_4));
	}
}

def tutorial_stage_3() {
	player_x = 1;
	world = world_new(player_x, 1, False);
	

	ar = global(ASSET_REGISTRY);
	cells_x = global(BOARD_CELLS_ALONG_X);

	crate_gap = cells_x - 3;

	x = 0;
	while  x < cells_x {
		if x != crate_gap  {
			crate_tex = ar.crates[random_int(len(ar.crates))];
			world.columns[x] = world.columns[x] + crate_new(x, 0, crate_tex);

			if x == crate_gap - 1 or x > crate_gap {
				crate_tex = ar.crates[random_int(len(ar.crates))];
				world.columns[x] = world.columns[x] + crate_new(x, 1, crate_tex);
			}
		}
		x = x + 1;
	}


	t = {};
	t.tick = &_tutorial_stage_3_tick;
	t.draw = &_tutorial_stage_3_draw;
	t.world = world;
	t.double_speed_crate_column = player_x + 2;
	t.player_stop_column = crate_gap - 1;


	t.double_speed_crate_spawn_timer = timer_new(0.5);
	t.double_speed_crate_spawned = False;
	timer_arm(t.double_speed_crate_spawn_timer);


	t.player_move_timer = timer_new(6);
	timer_arm(t.player_move_timer);
	return t;
}

def _tutorial_stage_3_tick(self, dt) {
	world_tick(self.world, dt);
	timer_tick(self.double_speed_crate_spawn_timer, dt);
	timer_tick(self.player_move_timer, dt);


	w = self.world;
	ar = global(ASSET_REGISTRY);
	if not self.double_speed_crate_spawn_timer.is_applied and not self.double_speed_crate_spawned {
		hc = pick_up_crate_new(self.double_speed_crate_column, global(BOARD_CELLS_ALONG_Y)+4, &pick_up_crate_behavior_double_speed, ar.double_speed_crate);
		w.columns[self.double_speed_crate_column] = w.columns[self.double_speed_crate_column] + hc;
		hc.on_added_to_board(hc);
		self.double_speed_crate_spawned = True;
	}


	if not self.player_move_timer.is_applied {
		if not (abs(w.player.x - self.player_stop_column) < 0.5) {
			w.player.move(w.player, global(HORIZONTAL_MOVEMENT_RIGHT), w);
		}
	}
}

def _tutorial_stage_3_draw(self) {
	RlBeginMode2D(global(BOARD_CAMERA));
	world_draw(self.world);
	RlEndMode2D();
	draw_hud(self.world.score, self.world.player.health, self.world.double_speed_timer.is_applied);
	draw_text_widget(550, 220, 400, 190, global(TUTORIAL_STAGE_3_TEXT));
}

# Tutorial stage 4 explaining the TNT crate.
def tutorial_stage_4() {
	ar = global(ASSET_REGISTRY);
	cells_x = global(BOARD_CELLS_ALONG_X);

	
	world = world_new(8, 0, False);
	
	x = 0;
	while x < 6 {
		crates_along_y = random_int(3);
		y = 0;
		col = world.columns[x];
		while y < crates_along_y + 1 {
			crate_tex = ar.crates[random_int(len(ar.crates))];
			col = col + crate_new(x, y, crate_tex);
			y = y + 1;
		}

		if x == 2 {
			ex = exploder_crate_new(x, global(BOARD_CELLS_ALONG_Y)+4, ar.exploder_crate);
			ex.on_added_to_board(ex);
			col = col + ex;
		}	

		world.columns[x] = col;
		x = x + 1;
	}

	t = {};
	t.tick = &_tutorial_stage_4_tick;
	t.draw = &_tutorial_stage_4_draw;
	t.world = world;

	t.text_index = 1;

	t.text2_timer = timer_new(24.5);
	t.text2_timer_done = False;

	timer_arm(t.text2_timer);
	return t;

}

def _tutorial_stage_4_tick(self, dt) {
	world_tick(self.world, dt);
	timer_tick(self.text2_timer, dt);

	if not self.text2_timer.is_applied and not self.text2_timer_done {
		self.text_index = 2;
		self.text2_timer_done = True;
	}
}

def _tutorial_stage_4_draw(self) {
	RlBeginMode2D(global(BOARD_CAMERA));
	world_draw(self.world);
	RlEndMode2D();
	draw_hud(self.world.score, self.world.player.health, self.world.double_speed_timer.is_applied);

	if self.text_index == 1 {
		draw_text_widget(550, 220, 400, 130, global(TUTORIAL_STAGE_4_TEXT_1));
	}

	if self.text_index == 2 {
		draw_text_widget(550, 220, 400, 255, global(TUTORIAL_STAGE_4_TEXT_2));
	}
}

# Splash screen game state.
def splashscreen_game_state_new() {
	game_state = {};
	game_state.run = &_splashscreen_game_state_run;
	return game_state;
}

def _splashscreen_game_state_run(self, game) {
	if RlIsKeyReleased(global(RL_KEY_ENTER)) {
		game.set_main_state(game);
	}

	if RlIsKeyReleased(global(RL_KEY_H)) {
		game.set_tutorial_state(game);
	}

	RlDrawText("This is a splashscreen", 10, 10, 40, 255,0,0);
}

# Game object. Exposes methods for game state switching.
def game_new() {
	game = {};
	game.game_state = splashscreen_game_state_new();
	game.set_splashscreen_state = &_game_set_splashscreen_state;
	game.set_main_state = &_game_set_main_state;
	game.set_tutorial_state = &_game_set_tutorial_state;
	return game;
}

def _game_set_splashscreen_state(self) {
	self.game_state = splashscreen_game_state_new();
}

def _game_set_main_state(self) {
	self.game_state = main_game_state_new();
}

def _game_set_tutorial_state(self) {
	self.game_state = tutorial_game_state_new();
}

def game_run(self) {
	RlInitWindow(global(SCREEN_WIDTH), global(SCREEN_HEIGHT));
	RlSetTargetFPS(60);

	# init Raylib first so that we can call RlLoadTexture
	load_assets();

	while not RlWindowShouldClose() {
		RlBeginDrawing();
		RlClearBackground(230, 230, 230);
		self.game_state.run(self.game_state, self);
		RlEndDrawing();
	}

	unload_assets();

	RlCloseWindow();
}

def main() {
	game = game_new();
	game_run(game);
}
