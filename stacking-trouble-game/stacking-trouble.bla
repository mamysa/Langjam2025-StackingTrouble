global CELL_SIZE = 64
global BOARD_CELLS_ALONG_X = 12
global BOARD_CELLS_ALONG_Y = 8


global HORIZONTAL_MOVEMENT_LEFT = -1
global HORIZONTAL_MOVEMENT_RIGHT = 1


global VERTICAL_MOVEMENT_FALLING = -1
global VERTICAL_MOVEMENT_JUMPING = 1

# steal these from raylib enum
global RL_KEY_SPACE = 32
global RL_KEY_RIGHT = 262
global RL_KEY_LEFT = 263


global MOVEMENT_EPS = 0.01
global VELOCITY = 2.0

global CRATE_HEIGHT = 1
global PLAYER_HEIGHT = 2

def board_x_coordinate_in_bounds(x) {
	return x >= 0 and x < global(BOARD_CELLS_ALONG_X);
}

def min(a, b) {
	return a if a < b else b;
}

def max(a, b) {
	return a if a > b else b;
}


# Interval represents line segment.
def interval_new(a, b) {
	interval = {};
	interval.min = min(a, b);
	interval.max = max(a, b);
	return interval;
}

# This checks if either interval b completely on the right of a or b os on the left of a and returns negation of that.
def intervals_overlap(a, b) {
	return not ((b.min > a.min and b.min > a.max) or (a.min > b.max and a.max > b.max));
}

# Player object. 
# (1) Stores (x,y) coodinates of the player. Can be float
# (2) Stores previousGoalX and currentGoalX int coordinates of target cells on the board.
#     Initially currentGoalX is None and previousGoalX is set to x. (x assumed to be an integer.)
# 	  When player moves, current_goal_x is set and movement is performed.
#     When player reaches his current_goal_x, last_goal_x = current_goal_x and set current_goal_x to None
# (3) To track in which direction player is moving, maintain horizontal_movement_kind. This will allow to
#     alter player's movement direction in certain cases. When player reaches his goal, this field is set to None.
# (4) goal_y for storing y coordinate player must reach while jumping. 
def player_new(x, y) {
	player = {};
	player.x = x;
	player.y = y;

	player.previous_goal_x = x;
	player.current_goal_x = None;

	player.horizontal_movement_kind = None;


	player.goal_y = None;
	player.vertical_movement_kind = None;

	player.move = &player_move;
	player.jump = &player_jump;
	player.tick = &player_tick;
	player.draw = &player_draw;
	player.get_y_axis_span = &player_get_y_span;

	return player;
}

def player_move(self, desired_horizontal_movement_kind, world) {
	if desired_horizontal_movement_kind == None {
		return False;
	}

	if desired_horizontal_movement_kind == self.horizontal_movement_kind {
		# do not allow player to queue multiple movements in the same direction
		return False;
	}

	# compute "bounding box" of the player along y axis
	player_interval = player_get_y_span_scaled(self);

	# player is not moving
	if self.horizontal_movement_kind == None {
		new_target_x = self.previous_goal_x + desired_horizontal_movement_kind;

		if not board_x_coordinate_in_bounds(new_target_x) {
			return False;
		}
		
		if world.interval_overlaps_any_in_column(world, player_interval, new_target_x) {
			return False;
		}

		self.current_goal_x = new_target_x;
		self.horizontal_movement_kind = desired_horizontal_movement_kind;

		return True;
	}

	# otherwise player is moving in the opposite direction, swap previous_goal_X and current_goal_x 
	# and update horizontal_movement_kind
	target_goal_x = self.previous_goal_x;

	# TODO do we even need this? Player's last goal was on the board anyways, right?
	if not board_x_coordinate_in_bounds(target_goal_x) {
		return False;
	}

	# we might not need this either since we are just leaving this cell...
	if world.interval_overlaps_any_in_column(world, player_interval, target_goal_x) {
		return False;
	}

	self.previous_goal_x = self.current_goal_x;
	self.current_goal_x = target_goal_x;
	self.horizontal_movement_kind = desired_horizontal_movement_kind;

	return True;
}

def player_jump(self) {
  # do not allow double jumping.
	if self.vertical_movement_kind != None {
		return False;
	}

	self.goal_y = self.y + 1 + global(MOVEMENT_EPS) * 2; 
	self.vertical_movement_kind = global(VERTICAL_MOVEMENT_JUMPING);
	return True;
}

def player_tick(self, dt, world) {
	player_tick_horizontal_movement(self, dt);
	player_tick_vertical_movement(self, dt, world);
}

# self = player
def player_tick_horizontal_movement(self, dt) {
	if self.horizontal_movement_kind == None {
		return;
	}

	horizontal_movement_float = float(self.horizontal_movement_kind);

	self.x = self.x + horizontal_movement_float * global(VELOCITY) * dt;

	distance_from_goal = (float(self.current_goal_x) - self.x) * horizontal_movement_float;

	# we have reached the goal
	if global(MOVEMENT_EPS) >= distance_from_goal {
		self.x = float(self.current_goal_x);
		self.previous_goal_x = self.current_goal_x;
		self.current_goal_x = None;
		self.horizontal_movement_kind = None;
	}
}

# If jumping apply contant velocity's to player's y component until destination is reached.
# Once destination has been reached, player goes into FALLING state in which case we simulate gravity until player
# reaches the ground.
def player_tick_vertical_movement(self, dt, world) {
	if self.vertical_movement_kind == global(VERTICAL_MOVEMENT_JUMPING){
		# we are jumping
		self.y = self.y + dt * global(VELOCITY);

		# find the difference between player's goalY and actual position Y and if it is close enough,
		# set player's vertical_movement_kind to falling.

		if self.goal_y - self.y < global(MOVEMENT_EPS) {
			self.y = self.goal_y;
			self.goal_y = None;
			self.vertical_movement_kind = global(VERTICAL_MOVEMENT_FALLING);
		}

	} else {
		# otherwise apply gravity here.
		# assume player is falling and apply gravity.
		self.vertical_movement_kind = global(VERTICAL_MOVEMENT_FALLING);


		ground = world.get_highest_in_column_below(world, self.y, self.previous_goal_x); 
		if self.horizontal_movement_kind != None {
			# player is moving, we sample current_goal_x as well and return maximum of those 
			ground = max(ground, world.get_highest_in_column_below(world, self.y, self.current_goal_x)); 
		}

		# apply gravity after sampling ground level. Otherwise, we will have a situation when object sinks into a valid crate.
		self.y = self.y - global(VELOCITY) * dt;

		# have we reached ground yet?
		if self.y - ground < global(MOVEMENT_EPS){
			self.y = ground; 
			self.vertical_movement_kind = None;  
		}
	}
}

def player_draw(self) {
	board_height = global(CELL_SIZE) * global(BOARD_CELLS_ALONG_Y);

	cell_start_x = global(CELL_SIZE) *  self.x;

	#subtract additional CELL_SIZE so that we account for player's height which is twice as large as other objects on scene.
	cell_start_y = board_height - (global(CELL_SIZE) * self.y) - global(CELL_SIZE);

	width = global(CELL_SIZE);
	height = global(CELL_SIZE) * 2; # player occupying two cells vertically.

	RlDrawRectangle(cell_start_x, cell_start_y, width, height, 0, 255, 0);
}

# This should be unused, right?
def player_get_y_span(self) {
	y_start = self.y;
	y_end = self.y + global(PLAYER_HEIGHT);
	return interval_new(y_start, y_end);
}

# so it turns out I actually need to sliighly scale down the interval to make movement work 
# on top of crates
def player_get_y_span_scaled(self) {
	y_start = self.y;
	y_end = self.y + global(PLAYER_HEIGHT);
	return interval_new(y_start+0.02, y_end-0.02);
}


# CRATE OBJECT
def crate_new(x, y) {
	crate = {};
	crate.x = x;
	crate.y = y;
	crate.previous_goal_x = x; 
	crate.draw = &crate_draw;
	crate.get_y_axis_span = &crate_get_y_axis_span;
	crate.color = {};
	crate.color.r = random_int(255);
	crate.color.g = random_int(255);
	crate.color.b = random_int(255);
	crate.tick = &crate_tick;
	return crate;
}

def crate_draw(self) {
	board_height = global(CELL_SIZE) * global(BOARD_CELLS_ALONG_Y);

	cellStartX = global(CELL_SIZE) *  self.x;
	cellStartY = board_height - (global(CELL_SIZE) * self.y);

	RlDrawRectangle(cellStartX, cellStartY, global(CELL_SIZE), global(CELL_SIZE), self.color.r, self.color.g, self.color.b);
}

def crate_tick(self, dt, world, crate_index) {
	crate_tick_vertical_movement(self, dt, world, crate_index);
}

# get previous crate in the column. 
# pass crate_index as an argument since we do not know the position of the crate, and I really don't want 
# to refactor compiler to compare references (at least before the deadline).
# TODO refactor to compare objects and lists by reference.
def crate_tick_vertical_movement(self, dt, world, crate_index) {
	column = world.columns[self.previous_goal_x];


	assert(crate_index >= 0);

	target_y = 0.0;
	if crate_index > 0 {
		previous_crate = column[crate_index-1];
		target_y = previous_crate.y + 1.0;
	}

	self.y = self.y - global(VELOCITY) * dt;

	if self.y < target_y {
		self.y = target_y;
	}

}

# computes minY, maxY of the crate on the board and returns Interval instance.
def crate_get_y_axis_span(self) {
	y_start = self.y;
	y_end = self.y + global(CRATE_HEIGHT);
	return interval_new(y_start, y_end);
}


# WORLD object.
# Is a collection of columns containing crates.
# Also contains player instance.
# All crates in columns are sorted by y coordinate.
def world_new() {
	columns = [];
	x = 0;
	while x < global(BOARD_CELLS_ALONG_X) {
		columns = columns + [];
		x = x + 1;
	}

	crate1 = crate_new(8, 0);
	crate2 = crate_new(2, 0);
	crate3 = crate_new(4, 0);
	columns[8] = columns[8] + crate1;
	columns[2] = columns[2] + crate2;
	columns[4] = columns[4] + crate3;
	
	world = {};
	world.columns = columns;
	world.player = player_new(0, 0);
	world.interval_overlaps_any_in_column = &world_interval_overlaps_any_in_column;
	world.get_highest_in_column_below = &world_get_highest_in_column_below;
	return world;
}

def world_tick(self, dt) {
	self.player.tick(self.player, dt, self);

	x  = 0;
	while x < len(self.columns) {
		column = self.columns[x];
		y = 0;
		while y < len(column) {
			crate = column[y];
			crate.tick(crate, dt, self, y);
			y = y + 1;
		}
		x = x + 1;
	}

	if random_float() < 0.008 {
		world_randomly_spawn_crate(self);
	}

}

def world_randomly_spawn_crate(self) {
	x = random_int(global(BOARD_CELLS_ALONG_X));
	y = global(BOARD_CELLS_ALONG_Y) + 2;

	crate = crate_new(x, y);

	can_spawn = True;
	column = self.columns[x];
	# inspect topmost element of the column
	if len(column) > 0 {
		last_crate = column[len(column)-1];
		
		if intervals_overlap(crate.get_y_axis_span(crate), last_crate.get_y_axis_span(last_crate)) {
			can_spawn = False;
		}
	}

	if can_spawn {
		self.columns[x] = column + crate;
	}

}

# returns true if given interval overlaps any crates in column with columnIndex.
def world_interval_overlaps_any_in_column(self, interval, column_index) {
	assert(board_x_coordinate_in_bounds(column_index)); # TODO we should really have messages here.

	column = self.columns[column_index];

	i = 0;
	while i < len(column) {
		crate = column[i];
		crate_interval = crate.get_y_axis_span(crate);

		if intervals_overlap(interval, crate_interval) {
		return True;

		}
		i = i + 1;
	}

	return False;
}

# returns y-coordinate of the crate is highest y below supplied y.
# For example, given below_y = 5 and ys = [7, 4, 3, 1]  4 should returning 
# TODO this name is confusing AF.
# TODO okay, so what happens when we have tiny overlap between some crate and y coordinate? It will 
# return wrong ground height.
def world_get_highest_in_column_below(self, below_y, column_index) {
	assert(board_x_coordinate_in_bounds(column_index)); # TODO we should really have messages here.
	#print(below_y);
	#print(column_index);

	column = self.columns[column_index];

	highest = 0;

	i = 0;
	while i < len(column) {
		box_top_y = column[i].y + 1;
		if below_y >= box_top_y {
			highest = max(highest, box_top_y);
		}
		i = i + 1;
	}

	#print(highest);

	return highest;
}

def world_draw(self) {
	columnIndex = 0;
	while columnIndex < len(self.columns) {
		column = self.columns[columnIndex];

		rowIndex = 0;
		while rowIndex < len(column) {
			crate = column[rowIndex];
			crate.draw(crate);
			rowIndex = rowIndex + 1;
		}

		columnIndex = columnIndex + 1;
	}

	self.player.draw(self.player);
}



def main() {
	RlInitWindow(800, 600);
	RlSetTargetFPS(60);



	world = world_new();
	print(world);

	current_time_ms = time();
	dt  = 0.01;
	accumulator = 0.0;
	

	while not RlWindowShouldClose() {

		if RlIsKeyDown(global(RL_KEY_SPACE)) {
			world.player.jump(world.player);
		}

		if RlIsKeyDown(global(RL_KEY_LEFT)) {
			world.player.move(world.player, global(HORIZONTAL_MOVEMENT_LEFT), world);
		}

		if RlIsKeyDown(global(RL_KEY_RIGHT)) {
			world.player.move(world.player, global(HORIZONTAL_MOVEMENT_RIGHT), world);
		}


		# physics main loop, shamlessly stolen from Gaffer On Games Fix your timestep 
		# we don't do any interpolation between states though.
		new_time_ms = time();
		frame_time = (new_time_ms - current_time_ms) / 1000.0;
		current_time_ms = new_time_ms;

		accumulator = accumulator + frame_time ;

		while dt < accumulator {
			world_tick(world, dt);
			accumulator = accumulator - dt;
		}


		RlBeginDrawing();
		RlClearBackground(255, 255, 255);


		world_draw(world);
		RlEndDrawing();
	}
	RlCloseWindow();
}

