def main() {
	b = booleanAnd();
}

def booleanAnd() {
	x =  boolean_test_expr_1_true() and boolean_test_expr_2_nevercalled() and boolean_test_expr_2_nevercalled();
	print(x);
}

def booleanOr() {
	x =  boolean_test_expr_1_true() or boolean_test_expr_2_nevercalled();
	print(x);
	x =  boolean_test_expr_2_nevercalled() or boolean_test_expr_1_true();
	print(x);
	x =  boolean_test_expr_2_nevercalled() or boolean_test_expr_2_nevercalled() or boolean_test_expr_2_nevercalled();
	print(x);
}


def boolean_test_expr_1_true() {
	print(900);
	return 124;
}

def boolean_test_expr_2_nevercalled() {
	print(0);
	return 0 ;
}

def ternary() {
x = 1337 if 0 else (1339 if 0 else 1440);
print(x);
}

def simpleArithmetic() {
i = 0;
while i < 3 {
	print(i);
	j = 10;
	while j < 13 {
		print(j);
		j = j + 1;
	}
i = i + 1;

}
}
