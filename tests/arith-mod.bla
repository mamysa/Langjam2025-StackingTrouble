def main() {
	print(12 % 5); 
	#? STDOUT 2
	print(-12 % 5); 
	#? STDOUT 3
	print(12 % -5); 
	#? STDOUT -3
	print(-12 % -5); 
	#? STDOUT -2

	print(12 % 5.7); 
	#? STDOUT 0.5999999999999996
	print(-12 % 5.7); 
	#? STDOUT 5.1000000000000005
	print(-12 % -5.7); 
	#? STDOUT -0.5999999999999996

	print(12.1 % 3); 
	#? STDOUT 0.09999999999999964
	print(12.1 % 3.2); 
	#? STDOUT 2.499999999999999
	}
